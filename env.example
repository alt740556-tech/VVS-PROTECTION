# Required
API_SECRET=change-me-long-random-string
DATABASE_URL=${{Postgres.DATABASE_URL}}   # Railway Postgres reference
SESSION_SECRET=change-me-long-random-string
NODE_ENV=production
PGSSL=false

# Discord
DISCORD_CLIENT_ID=
